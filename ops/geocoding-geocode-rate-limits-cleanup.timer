# Fires geocoding-geocode-rate-limits-cleanup.service weekly -- rows
# accumulate continuously (one per distinct IP per day), so this runs
# much more often than the once-a-year TIGER update. Adjust OnCalendar/
# the retention window (the "90" argument in the .service file) to
# taste.
#
# Persistent=true means a run missed while the box was off gets caught
# up at next boot instead of silently skipped.

[Unit]
Description=Run geocoding-geocode-rate-limits-cleanup.service weekly

[Timer]
OnCalendar=weekly
Persistent=true

[Install]
WantedBy=timers.target
