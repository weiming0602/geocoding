# Fires geocoding-feedback-cleanup.service weekly -- comments accumulate
# continuously (unlike the once-a-year TIGER update), so this runs much
# more often. Adjust OnCalendar/the retention window (the "90" argument
# in the .service file) to taste.
#
# Persistent=true means a run missed while the box was off gets caught
# up at next boot instead of silently skipped.

[Unit]
Description=Run geocoding-feedback-cleanup.service weekly

[Timer]
OnCalendar=weekly
Persistent=true

[Install]
WantedBy=timers.target
