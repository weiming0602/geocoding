# systemd service for geocoding-server/scripts/transactions-digest.js --
# emails the owner (TRANSACTIONS_NOTIFY_EMAIL) every purchase completed
# since the last digest, then marks them notified. Triggered by
# geocoding-transactions-digest.timer, not meant to be started directly
# (though `systemctl start` works fine for a manual test run).
#
# Install (on the Lightsail instance, adjust paths/DSN for that box):
#   sudo cp ops/geocoding-transactions-digest.service ops/geocoding-transactions-digest.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now geocoding-transactions-digest.timer
#
# Check status / logs:
#   systemctl status geocoding-transactions-digest.timer
#   journalctl -u geocoding-transactions-digest.service

[Unit]
Description=Email the owner a daily digest of completed transactions

[Service]
Type=oneshot
WorkingDirectory=/home/my_ai/projects/geocoding/geocoding-server
# USERS_DSN should point at the Lightsail Database's network endpoint in
# production, not the local Unix socket used in dev -- see CLAUDE.md's
# "Environment / data layout".
Environment=USERS_DSN=postgresql://my_ai@%2Fvar%2Frun%2Fpostgresql/geocoding_users
# Adjust this path to wherever `which node` resolves on the actual box.
ExecStart=/home/my_ai/.local/node/bin/node scripts/transactions-digest.js
