# systemd service for ops/backup-databases.sh -- pg_dumps both
# `geocoding` and `geocoding_users` (the latter has real customer data:
# accounts, service keys, quota, feedback) to a local backup directory,
# pruning anything older than 14 days. Triggered by
# geocoding-backup.timer, not meant to be started directly (though
# `systemctl start` works fine for a manual test run).
#
# Install (on the Lightsail instance, adjust paths for that box -- and
# see backup-databases.sh's own header for the local-disk-only caveat):
#   sudo cp ops/geocoding-backup.service ops/geocoding-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now geocoding-backup.timer
#
# Check status / logs:
#   systemctl status geocoding-backup.timer
#   journalctl -u geocoding-backup.service

[Unit]
Description=Back up geocoding and geocoding_users Postgres databases

[Service]
Type=oneshot
# pg_dump also authenticates via Postgres peer authentication (see
# CLAUDE.md's "Environment / data layout") -- must run as the same OS
# user as the database role being dumped, not root's default.
User=my_ai
Group=my_ai
ExecStart=/home/my_ai/geocoding/ops/backup-databases.sh
