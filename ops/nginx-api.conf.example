# Example nginx site for api.meridiangeocoding.com once the API runs as two
# processes on one droplet (see ops/road-alerts-server.service for the
# rollout order). Not a drop-in replacement for the deployed file: certbot
# manages the TLS lines in /etc/nginx/sites-enabled/ on each droplet, so
# the safest change there is to add ONLY the Road Alerts `location` block
# below to the existing server block, above its `location /`.
#
# Paths, not a subdomain: the frontend keeps using one API base URL, and no
# new DNS record or certificate is needed. test/serverSplit.test.js checks
# that every Road Alerts route (and nothing else) matches this pattern.

server {
    server_name api.meridiangeocoding.com;

    # Batch geocoding accepts large fileContent uploads -- matches the
    # express.json({ limit: '200mb' }) ceiling in src/serverSetup.js.
    client_max_body_size 200m;

    # Road Alerts -> src/roadAlertsServer.js (ROAD_ALERTS_PORT, 3002).
    # Matches /road-alerts, /road-alerts/..., /road-signals, /road-signals/...
    location ~ ^/(road-alerts|road-signals)(/|$) {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        # Both processes set `trust proxy: loopback` and key per-IP logic on
        # these -- same headers for both locations.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else (geocoding, batch, quota, billing, places, feedback,
    # admin) -> src/geocodingServer.js (PORT, 3001).
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # listen 443 ssl; ssl_certificate ...;  <- managed by certbot on the box
}
