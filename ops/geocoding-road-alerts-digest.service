# systemd service for geocoding-server/scripts/road-alerts-digest.js --
# emails each opted-in Road Alerts account a digest of alerts they
# explicitly saved (voice "save"/"keep"/"email" command) since the last
# digest, then clears what was sent. Triggered by
# geocoding-road-alerts-digest.timer, not meant to be started directly
# (though `systemctl start` works fine for a manual test run).
#
# Install (on the Lightsail instance, adjust paths/DSN for that box):
#   sudo cp ops/geocoding-road-alerts-digest.service ops/geocoding-road-alerts-digest.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now geocoding-road-alerts-digest.timer
#
# Check status / logs:
#   systemctl status geocoding-road-alerts-digest.timer
#   journalctl -u geocoding-road-alerts-digest.service

[Unit]
Description=Email each opted-in Road Alerts account its daily digest

[Service]
Type=oneshot
# Postgres peer authentication (see CLAUDE.md's "Environment / data
# layout") matches the connecting OS user to the requested role -- the
# DSN below requests role "my_ai", so this must run as that same OS
# user, not root's default. Without this, every query fails with
# "Peer authentication failed for user \"my_ai\"".
User=my_ai
Group=my_ai
WorkingDirectory=/home/my_ai/geocoding/geocoding-server
# USERS_DSN should point at the Lightsail Database's network endpoint in
# production, not the local Unix socket used in dev -- see CLAUDE.md's
# "Environment / data layout". The socket path's "/" must be doubled
# (%%2F, not %2F): systemd treats a single "%" in Environment= as the
# start of one of its own specifiers (e.g. %h for $HOME) and silently
# drops the whole assignment if it can't resolve one -- "%2F" isn't a
# real specifier, so the DSN never actually got set without this, and
# the script silently fell back to its own hardcoded default instead.
Environment=USERS_DSN=postgresql://my_ai@%%2Fvar%%2Frun%%2Fpostgresql/geocoding_users
# Adjust this path to wherever `which node` resolves on the actual box.
ExecStart=/usr/bin/node scripts/road-alerts-digest.js
