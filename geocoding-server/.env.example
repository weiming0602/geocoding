# Copy this file to .env and fill in real values yourself -- .env is
# gitignored and this repo never commits your actual secret. Without
# STRIPE_SECRET_KEY set, checkout falls back to the deliberate no-op stub
# (see billing.js) and no real Stripe API call happens.

# From the Stripe Dashboard's Developers > API keys. An `sk_test_...` key
# runs Stripe's test mode (no real money; pay with card 4242 4242 4242
# 4242); switch to the `sk_live_...` key only once you're ready to take
# real payments -- and set VITE_STRIPE_ENV/EXPO_PUBLIC_STRIPE_ENV=live on
# the frontends so the checkout page stops saying "test mode". Only ever
# read here, server-side; Stripe's hosted checkout page needs no
# client-side key at all.
STRIPE_SECRET_KEY=

# Signing secret for POST /billing/stripe-webhook (Dashboard: Developers >
# Webhooks > add an endpoint at https://<api host>/billing/stripe-webhook
# for checkout.session.completed + checkout.session.async_payment_succeeded,
# then "Reveal" its signing secret; locally, `stripe listen
# --forward-to localhost:3001/billing/stripe-webhook` prints one). Unset =
# the webhook route 404s, and a purchase is only fulfilled when the buyer's
# browser comes back from Stripe -- a buyer who closes the tab first (or
# pays by bank debit, which clears days later) never gets their quota.
STRIPE_WEBHOOK_SECRET=

# AWS SES -- emails the service key after a successful purchase
# (see emailDelivery.js's sendServiceKeyEmail). Without all three set,
# it falls back to a stub (logs and returns; the key is still shown on
# screen either way). Use an IAM user scoped to only ses:SendEmail, not
# root/admin credentials. SES_FROM_EMAIL must be a verified identity in
# that AWS account/region; while the SES account is still in its sandbox,
# the recipient address must ALSO be verified, or the send will fail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=

# Where POST /feedback notifies you of a new comment/question (see
# emailDelivery.js's sendFeedbackNotification) -- your own real inbox,
# not a sender identity. Uses the same SES credentials above; without
# this set (even with SES otherwise configured), notifications fall
# back to the log-only stub. The comment is saved in Postgres either way.
FEEDBACK_NOTIFY_EMAIL=

# Web Push for Road Alerts' background (closed-tab/installed-PWA) hazard
# alerts -- see scripts/road-alerts-push-worker.js and
# docs/superpowers/specs/2026-09-17-road-alerts-background-push-design.md.
# Optional -- unset = the feature is silently disabled (GET
# /road-signals/push-public-key 404s, and the push worker runs but never
# sends anything). Generate once with `npx web-push generate-vapid-keys`;
# VAPID_SUBJECT is a mailto: contact address the push spec requires.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# DANGER -- testing convenience ONLY. When "true": (1) all three batch
# endpoints accept an empty serviceKey for ANY known email (a wrong,
# non-empty key is still rejected); (2) /geocode/batch and
# /geocode/batch/download also accept no email at all, running as a pure
# smoke test with no account/quota touched (see server.js's
# emailProvided checks and quota.js's checkQuota). /geocode/batch/email
# always requires a real email regardless -- that's the address results
# get sent to. This defeats the entire point of the service key: knowing
# just an email becomes enough to spend that account's quota again.
# Leave unset everywhere real customers' quota is at stake -- there's no
# separate staging server in this setup, so if this box is also the one
# taking live payments, do NOT set this here. Logs a loud warning at
# startup when enabled.
ALLOW_TEST_EMPTY_SERVICE_KEY=
