# Copy this file to .env and fill in real values yourself -- .env is
# gitignored and this repo (and Claude) never writes your actual secret
# into it. Without these two set, /billing/purchase falls back to the
# deliberate no-op stub (see billing.js) and no real PayPal API call
# happens.

# From a PayPal Developer Dashboard REST API app ("Apps & Credentials").
# The Client ID alone is also embedded client-side in Checkout.tsx /
# CheckoutSection.web.tsx -- it's meant to be public. The Client Secret
# is not; it's only ever read here, server-side.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# https://api-m.sandbox.paypal.com while testing (the default if unset);
# switch to https://api-m.paypal.com only once you're ready to take real
# payments, with a live (not sandbox) app's credentials above.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AWS SES -- emails the service key after a successful /billing/purchase
# (see emailDelivery.js's sendServiceKeyEmail). Without all three set,
# it falls back to a stub (logs and returns; the key is still shown on
# screen either way). Use an IAM user scoped to only ses:SendEmail, not
# root/admin credentials. SES_FROM_EMAIL must be a verified identity in
# that AWS account/region; while the SES account is still in its sandbox,
# the recipient address must ALSO be verified, or the send will fail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=
